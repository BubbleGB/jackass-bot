# Default foundation mode validates configuration and exits without live services.
NODE_ENV=development
APP_MODE=foundation
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ENCRYPTION_KEY_VERSION=1

# Isolated LOCAL development database only; see compose.dev.yaml.
# These are public test credentials. Never reuse them for deployment.
DATABASE_URL=postgresql://galaxy_test:galaxy_test@127.0.0.1:55432/galaxy_neegy_test
TEST_DATABASE_URL=postgresql://galaxy_test:galaxy_test@127.0.0.1:55432/galaxy_neegy_test

# Not needed for mocked tests. Never put real credentials in this example or Git.
# Runtime mode is implemented; activation with live credentials belongs to Task 9.
# Production Compose mounts secret files; see docs/runbook.md.
# ENCRYPTION_KEY=<canonical base64 of 32 random bytes>
# DISCORD_BOT_TOKEN=<set through secret storage>
# DISCORD_CLIENT_ID=<application snowflake>
# DISCORD_CLIENT_SECRET=<set through secret storage>
# CREATOR_USER_ID=<creator snowflake>

# Explicit test-guild registration only; no registration runs on startup/reconnect.
# DISCORD_TEST_GUILD_ID=

# Optional public HTTPS or mailto contact link; omit until the creator supplies it.
# CONTACT_URL=
