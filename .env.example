# Task 1: validates configuration and exits; no Discord/provider/network startup.
NODE_ENV=development
APP_MODE=foundation
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ENCRYPTION_KEY_VERSION=1

# Isolated LOCAL development database only; see compose.dev.yaml.
# These are public test credentials. Never reuse them for deployment.
DATABASE_URL=postgresql://galaxy_test:galaxy_test@127.0.0.1:55432/galaxy_neegy_test
TEST_DATABASE_URL=postgresql://galaxy_test:galaxy_test@127.0.0.1:55432/galaxy_neegy_test

# Not needed for Task 1. Never put real credentials in this example or Git.
# Runtime mode is reserved for later tasks and requires all fields below.
# ENCRYPTION_KEY=<canonical base64 of 32 random bytes>
# DISCORD_BOT_TOKEN=<set through secret storage>
# DISCORD_CLIENT_ID=<application snowflake>
# DISCORD_CLIENT_SECRET=<set through secret storage>
# CREATOR_USER_ID=<creator snowflake>
